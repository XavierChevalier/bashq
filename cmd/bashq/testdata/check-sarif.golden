{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "bashq",
          "version": "dev",
          "informationUri": "https://github.com/XavierChevalier/bashq",
          "rules": [
            {
              "id": "cognitive-complexity",
              "shortDescription": {
                "text": "a function is hard to understand: too many branches, nested too deep"
              },
              "helpUri": "https://github.com/XavierChevalier/bashq/blob/main/docs/rules.md#cognitive-complexity"
            },
            {
              "id": "duplication",
              "shortDescription": {
                "text": "a block of code is a copy of another one"
              },
              "helpUri": "https://github.com/XavierChevalier/bashq/blob/main/docs/rules.md#duplication"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "cognitive-complexity",
          "level": "warning",
          "message": {
            "text": "deploy::main has a cognitive complexity of 17 (max 15)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/deploy/deploy.sh"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 43
                }
              }
            }
          ],
          "partialFingerprints": {
            "bashq/v1": "34a6cb4245533bde"
          }
        },
        {
          "ruleId": "duplication",
          "level": "warning",
          "message": {
            "text": "23 lines duplicate examples/deploy/deploy.sh:46-68"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/deploy/rollback.sh"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 30
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/deploy/deploy.sh"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 68
                }
              },
              "message": {
                "text": "original copy"
              }
            }
          ],
          "partialFingerprints": {
            "bashq/v1": "feaa919c79d33c4c"
          }
        }
      ]
    }
  ],
  "version": "2.1.0"
}
